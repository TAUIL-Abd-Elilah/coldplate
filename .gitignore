# build artefacts
lib/
*.so
!tesseracts/thermal_fortran/toolchain/vendor/LLVMEnzyme-19.so
*.dll
*.obj
*.lib
*.exp
*.o

# large raw run data is regenerated by the scripts; figures are kept
*.npz
results_smoke/
results_diag/
orchestrator/evidence_download_*/

# python. The glob is deliberately wide: a reviewer who makes a virtualenv
# inside the clone is doing the obvious thing, and it should not turn the
# submission check's clean-tree gate into a confusing failure.
__pycache__/
*.pyc
.venv*/
venv*/
env/
.env/
*.egg-info/

# editors / os
.DS_Store
.vscode/
.idea/

# regenerated narration segments, slides and intermediate video streams
demo/build/

# paper PDF is a build artefact of PAPER.md; regenerate with scripts/build_paper.sh
# (kept tracked anyway so judges do not need a LaTeX install)

# Local caption-safety preview render: a 12.7 MB duplicate of the release
# video, referenced by nothing. Regenerated on demand by the video tooling.
demo/caption-safe-preview.mp4

# The Piper voice model for the locally narrated video variant: 109 MB of ONNX
# weights, downloaded once and pinned by SHA-256 in scripts/build_demo_video.py.
# The rendered MP4 is the deliverable; the model is a build input.
demo/voices/
